# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/shrivi-creations

# JWT
JWT_SECRET=replace_with_a_long_random_secret_key
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Cloudinary
CLOUDINARY_CLOUD_NAME=name
CLOUDINARY_API_KEY=123
CLOUDINARY_API_SECRET=secret

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Nodemailer (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Shrivi Creations <no-reply@shrivicreations.com>"

# Admin seed (used by npm run seed)
ADMIN_NAME=Shrivi Admin
ADMIN_EMAIL=admin@shrivicreations.com
ADMIN_PASSWORD=Admin@12345
